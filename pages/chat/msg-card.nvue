<template v-if="show">
	<view>
		<view class="chathistorydate" v-if="this.isShowDate">
			<text class="chatmessagedate">{{sendDate}}</text>
		</view>

		<view class="chatinfocard">
			<template v-if="!self">
				<view class="friendchatcard">
					<view class="chatavatar">
						<image @click="showInfo()" class="chatavatar-img" v-bind:src="waiterAvatar">
						</image>
					</view>
					<view class="chatmessage">
						<msg-content :msg="msg" :msgList="msgList" />
					</view>
					<view class="chatmessagelabe">
						<view class="chatmessagetime">{{msgTime}}</view>
					</view>
				</view>
			</template>

			<template v-else>
				<view class="selfchatcard">
					<view class="chatmessagelabe">
						<view class="chatmessagestate">{{msg.isRead}}</view>
						<view class="chatmessagetime">{{msgTime}}</view>
					</view>
					<view class="chatmessage" selectable="true">
						<msg-content :msg="msg" :msgList="msgList" />
					</view>
				</view>
			</template>
		</view>
	</view>
</template>

<script>
	import {
		msgDate,
	} from "@/common/util.js";
	import msgContent from "./msg-content.nvue";
	import dayjs from "dayjs";
	import {
		formatTimestamp
	} from "@/common/format.js";

	export default {
		components: {
			msgContent
		},
		props: {
			msg: {
				type: Object,
				default: null
			},
			isShowDate: {
				type: Boolean,
				default: false
			},
			msgList: {
				type: Array,
				default: [],
			},
			showInfo: {
				type: Function,
				default: function() {}
			}
		},
		data() {
			return {
				waiterAvatar: "https://img.alicdn.com/imgextra/i1/917298378/O1CN01Su4K112BlAqorDkFr_!!917298378.jpg",
				msgTime: this.msgTimeFormat(),
				show: this.verifyMsg(),
				self: this.authMsgFromSelf(this.msg),
				sendDate: this.messageDate(),
			};
		},
		mounted() {
			// console.log(this.msgList)
		},
		methods: {
			messageDate() {
				return msgDate(this.msg.timestamp * 1000 || new Date().getTime());
			},
			msgTimeFormat() {
				let t = this.msg.timestamp * 1000
				return dayjs(t).format("HH:mm")
			},
			verifyMsg() {
				if (typeof this.msg?.contentType !== "number") return false
				let contentType = this.msg.content.realContentType || this.msg.content._contentType ||  this.msg.content?.contentObj?.type
				switch (contentType) {
					case 1, undefined:
						//默认为文本消息
						let text = this.msg.content.text || this.msg.content?.contentObj?.content
						if (typeof text !== "string") {
							return false
						}
						return text.trim().length !== 0
					case 2:
						//图片消息
						let url = this.msg.content?.contentObj?.url
						if (!url) return false
						url = url + ""
						if (url.trim().length === 0) return false
					default:
						//其它类型消息，暂不支持
						return false
				}
			},
			authMsgFromSelf(msg) {
				return msg.fromUID === getApp().globalData.chatUid || msg.channel.channelID !== msg.fromUID
			},
		},
	};
</script>

<style>
	.uni-list-item__header {
		display: none;
	}

	.chathistorydate {
		width: 100%;
		text-align: center;
		margin-bottom: 4px;
	}

	.chatmessagedate {
		font-size: 12px;
		line-height: 12px;
		color: #fff;
		background-color: #00000028;
		padding: 3px 8px;
		border-radius: 13px;
		font-weight: lighter;
	}

	.chatinfocard {
		margin-bottom: 4px;
	}

	.selfchatcard {
		display: flex;
		justify-content: flex-end;
		min-height: 30px;
	}

	.chatmessagelabe {
		min-width: 60px;
		position: relative;
		display: flex;
		justify-content: flex-end;
		align-items: flex-end;
		flex-direction: column;
	}

	.chatmessagetime,
	.chatmessagestate {
		min-width: 60px;
		font-size: 8px;
		line-height: 12px;
		word-break: break-all;
		letter-spacing: 0px;
		color: #3e5474;
		font-weight: bold;
	}

	.chatmessagestate {
		display: none;
	}

	.selfchatcard>.chatmessage {
		background-color: #93DF83;
	}

	.selfchatcard>.chatmessage::before {
		content: '';
		width: 0;
		height: 0;
		border: 10px solid transparent;
		border-bottom-color: #93DF83;
		top: -6px;
		right: -3px;
		position: absolute;
		z-index: 0;
		transform: rotate(-60deg);
	}

	.chatmessage {
		margin: 4px 4px 0;
		position: relative;
		text-align: left;
		max-width: 100%;
		background-color: #fff;
		border-radius: 14px;
		padding: 6px;
		font-size: 14px;
		font-weight: bold;
		color: #111111;
		word-break: break-all;
		white-space: pre-wrap;
	}

	.friendchatcard {
		display: flex;
		justify-content: flex-start;
		min-height: 30px;
	}

	.chatavatar {
		height: 30px;
		width: 30px;
		min-width: 30px;
		overflow: hidden;
		border-radius: 50%;
		margin-right: 4px;
		background-color: #fff;
	}

	.chatavatar .chatavatar-img {
		height: 30px;
		width: 30px;
		margin: 0;
		padding: 0;
		border: none;
		vertical-align: middle;
		background-color: #fff;
	}

	.friendchatcard .chatmessage {
		background-color: #fff;
	}

	.friendchatcard .chatmessage::before {
		content: '';
		width: 0;
		height: 0;
		border: 10px solid transparent;
		border-bottom-color: #fff;
		top: -6px;
		left: -3px;
		position: absolute;
		z-index: 0;
		transform: rotate(60deg);
	}

	.friendchatcard .chatmessagelabe {
		text-align: left;
	}

	.selfchatcard .chatmessagelabe {
		text-align: right;
	}
</style>